  text: "Bengali / \u09AC\u09BE\u0982\u09B2\u09BE\n\u09AC\u09BE\u0982\u09B2\u09BE
    \u09AD\u09BE\u09B7\u09BE \u09AA\u09C3\u09A5\u09BF\u09AC\u09C0\u09B0 \u0985\u09A8\u09CD\u09AF\u09A4\u09AE
