  text: "Bengali / \u09AC\u09BE\u0982\u09B2\u09BE\n\u09AC\u09BE\u0982\u09B2\u09BE
    \u09AD\u09BE\u09B7\u09BE \u09AA\u09C3\u09A5\u09BF\u09AC\u09C0\u09B0 \u0985\u09A8\u09CD\u09AF\u09A4\u09AE
    \u09B8\u09C1\u09A8\u09CD\u09A6\u09B0 \u09AD\u09BE\u09B7\u09BE\u0964 \u0986\u09AE\u09B0\u09BE
    \u09B8\u09CD\u09AC\u09AA\u09CD\u09A8 \u09A6\u09C7\u0996\u09BF \u098F\u0995\u099F\u09BF
    \u09B8\u09C1\u09A8\u09CD\u09A6\u09B0 \u0986\u0997\u09BE\u09AE\u09C0\u09B0\u0964\n\u0995\u0996\u0997\u0998\u0999\u099A\u099B\u099C\u099D\u099E\u099F\u09A0\u09A1\u09A2\u09A3\u09A4\u09A5\u09A6\u09A7\u09A8\u09AA\u09AB\u09AC\u09AD\u09AE\u09AF\u09B0\u09B2\u09B6\u09B7\u09B8\u09B9\n\u0995\u09CD\u09B7
    \u099C\u09CD\u099E \u09A4\u09CD\u09B0 \u09B6\u09CD\u09B0 \u09A6\u09CD\u09A7 \u09A8\u09CD\u09A4\u09CD\u09B0
    \u09B8\u09CD\u09A4\u09CD\u09B0\n\u0995\u09BE \u0995\u09BF \u0995\u09C0 \u0995\u09C1
    \u0995\u09C2 \u0995\u09C7 \u0995\u09C8 \u0995\u09CB \u0995\u09CC\n\u09E6\u09E7\u09E8\u09E9\u09EA\u09EB\u09EC\u09ED\u09EE\u09EF\n\nDevanagari
    / \u0926\u0947\u0935\u0928\u093E\u0917\u0930\u0940\n\u0939\u093F\u0928\u094D\u0926\u0940
    \u0935\u093F\u0936\u094D\u0935 \u0915\u0940 \u092A\u094D\u0930\u092E\u0941\u0916
    \u092D\u093E\u0937\u093E\u0913\u0902 \u092E\u0947\u0902 \u0938\u0947 \u090F\u0915
    \u0939\u0948\u0964 \u0939\u0930 \u0905\u0915\u094D\u0937\u0930 \u092E\u0947\u0902
    \u090F\u0915 \u0915\u0939\u093E\u0928\u0940 \u091B\u093F\u092A\u0940 \u0939\u094B\u0924\u0940
