  pointerRoutingProfile:
    id: 
  text: "<p><k>Tracking</k>\L<ls=0.32em>HEADLINE</ls> \xB7 <ls=-0.04em>tight display text</ls></p>\n<p><k>Arabic stretches with kashida instead of breaking its joins</k>\L\u0627\u0644\u0639\u0631\u0628\u064A\u0629 \u2190 <ls=0.35em>\u0627\u0644\u0639\u0631\u0628\u064A\u0629</ls></p>\n<p><k>Word spacing</k>\L<ws=0.9em>words far apart</ws></p>\n<k>Figures that never jump</k>"
