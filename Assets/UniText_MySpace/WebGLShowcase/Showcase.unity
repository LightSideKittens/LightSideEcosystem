      m_Calls: []
  pointerRoutingProfile:
    id: 
  text: '<h>Tables</h>


    \begin{tabular}{|p{5cm}|p{7cm}|}

    \hline

    \multicolumn{2}{|c|}{\textbf{Precipitation reaction}} \\

    \hline

    \textbf{Step} & \textbf{Observation} \\

    \hline

    Lead nitrate solution is taken in a test tube & Colorless solution is observed \\

    \hline

    Potassium iodide solution is added & A yellow precipitate of $\mathrm{PbI_2}$ forms at once \\

    \hline

    Type of reaction & Precipitation and \textit{double displacement} \\

    \hline

    \end{tabular}


    Every cell is a paragraph: bold, color and formulas work inside it.


    \begin{tabular}{lcr}

    \hline

    \textbf{Element} & \textbf{Symbol} & \textbf{Density} \\

    \hline

    Iron & Fe & 7.87 \\

    Copper & Cu & 8.96 \\

    Gold & Au & 19.3 \\

    \hline

    \end{tabular}'
  font: {fileID: 0}
  fontStack: {fileID: 11400000, guid: f97b73f40188e524b8374a6cdee8b200, type: 2}
  fontSize: 29
  wordWrap: 1
