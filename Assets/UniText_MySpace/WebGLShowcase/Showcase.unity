  pointerRoutingProfile:
    id: 
  text: "<p><k>German</k>\Lstra\xDFe \u2192 <upper>stra\xDFe</upper></p>\n<p><k>English \xB7 Turkish</k>\L<upper>istanbul</upper> \xB7 <lang=tr><upper>istanbul</upper></lang> \u2014 <lang=tr><lower>D\u0130YARBAKIR</lower></lang></p>\n<p><k>Greek drops accents and keeps the dialytika</k>\L\u0395\u03BB\u03BB\u03B7\u03BD\u03B9\u03BA\u03AC \xB7 \u03AC\u03C5\u03BB\u03BF\u03C2 \u2192 <lang=el><upper>\u0395\u03BB\u03BB\u03B7\u03BD\u03B9\u03BA\u03AC \xB7 \u03AC\u03C5\u03BB\u03BF\u03C2</upper></lang></p>\n<p><k>Greek final sigma</k>\L\u039F\u0394\u039F\u03A3 \u03A3\u039F\u03A6\u039F\u03A3 \u2192 <lower>\u039F\u0394\u039F\u03A3 \u03A3\u039F\u03A6\u039F\u03A3</lower></p>\n<k>The text stays as typed: only its look changes</k>\LSelect it, copy it, search it \u2014 it is still \u201Cistanbul\u201D."
  font: {fileID: 0}
  fontStack: {fileID: 11400000, guid: 005a3e12a7b1df540b593acccadd26b3, type: 2}
  fontSize: 38
  wordWrap: 1
