      tip.Behaviors: DecimalFilter, SingleLineBehavior

      country: UniTextDropdown'
  - variant: profile
    view: {fileID: 4461592}
    text: {fileID: 0}
    setup: 'username.Behaviors: CaseTransformBehavior(Lower), AlphanumericFilter, LengthLimitBehavior(16), CharacterCounterDecorator

      promo.Behaviors: CaseTransformBehavior(Upper), AlphanumericFilter

      phone.Behaviors: InputMaskBehavior("+# (###) ###-####")

      about.Behaviors: LengthLimitBehavior(120 graphemes), CharacterCounterDecorator'
