  panels:
  - variant: signup
    view: {fileID: 670203257}
    text: {fileID: 0}
    setup: 'name.Behaviors: FloatingLabelDecorator, NameFilter, SingleLineBehavior

      email.Behaviors: FloatingLabelDecorator, EmailFilter, EmailValidator, AutoValidateBehavior, SupportingTextDecorator

      password.Behaviors: FloatingLabelDecorator, PasswordBehavior   // PasswordBehavior.Revealed shows the letters'
